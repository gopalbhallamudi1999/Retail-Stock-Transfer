{
  "name": "retail-stock-transfer-cap",
  "version": "1.0.0",
  "description": "Retail stock transfers with approval, dispatch, and receipt",
  "scripts": {
    "test": "node --test",
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production",
    "build:mta": "mbt build"
  },
  "type": "commonjs",
  "dependencies": {
    "@cap-js/hana": "^2.8.3",
    "@sap/cds": "^9.9.4",
    "@sap/xssec": "^4",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.3",
    "@sap/cds-dk": "^9.9.8",
    "better-sqlite3": "12.9.0",
    "mbt": "^1.2.53"
  },
  "private": true,
  "engines": {
    "node": "^22 || ^24"
  },
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      }
    },
    "build": {
      "tasks": [
        {
          "for": "hana",
          "src": "db",
          "options": {
            "model": [
              "db",
              "srv",
              "app"
            ]
          }
        },
        {
          "for": "nodejs",
          "src": "srv",
          "options": {
            "model": [
              "db",
              "srv",
              "app"
            ]
          }
        }
      ]
    }
  }
}
